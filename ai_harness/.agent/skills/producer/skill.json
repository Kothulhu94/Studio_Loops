{
  "id": "studio-loop.producer",
  "name": "Studio Loop Concept Producer",
  "version": "1.0.0",
  "roles": ["concept_producer"],
  "required_tools": ["file_writer", "research_requests", "git_status"],
  "allowed_write_paths": [".agent/Loop_Flow", "docs/adr"],
