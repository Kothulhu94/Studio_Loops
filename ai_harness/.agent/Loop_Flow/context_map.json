{
  "context_layers": {
    "permanent": [
      ".agent/skills/",
      ".agent/workflows/",
      ".agent/orchestrator/templates/"
    ],
    "ephemeral": [
      "research_logs/",
      "command_outputs/",
      "agent_monologues/"
    ],
    "artifact_priority": {
      "high": ["code", "schemas", "skill_definitions"],
      "medium": ["documentation", "test_results"],
      "low": ["raw_search_results", "browser_snapshots"]
    }
  },
  "pruning_strategies": {
    "token_based": {
      "threshold": 0.8,
      "action": "drop_lowest_priority"
    },
    "event_based": {
      "trigger": "role_transition",
      "action": "summarize_ephemeral"
    }
  }
}